{
  "name": "vendor-verification-system",
  "version": "1.0.0",
  "description": "供应商核销系统 - 后台管理和H5核销端",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:h5": "pnpm --filter h5 dev",
    "build": "pnpm -r build",
    "build:admin": "pnpm --filter admin build",
    "build:h5": "pnpm --filter h5 build",
    "preview": "pnpm -r preview",
    "preview:admin": "pnpm --filter admin preview",
    "preview:h5": "pnpm --filter h5 preview",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check"
  },
  "keywords": [
    "vue3",
    "vite",
    "typescript",
    "vendor",
    "verification"
  ],
  "author": "chenzhyu",
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "eslint-plugin-vue": "^9.0.0",
    "typescript": "^5.1.6"
  }
}
